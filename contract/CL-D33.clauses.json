{
  "clauses": [
    {
      "id": "CL-D33-boundary",
      "marker": "CL-D33",
      "title": "The driver reads the template, replaces the six placeholders once, and drafts exactly two artifacts in a fresh directory the operator publishes",
      "files": [
        "skills/closed-loop-pr/driver/run.js"
      ],
      "requires": [
        "const template = fs.readFileSync(path.join(PACKAGE, 'skills', 'closed-loop-pr', 'references', 'publish-review.sh'), 'utf8');",
        "const script = template.replaceAll('__PI_REVIEW_REPOSITORY__', t.repository).replaceAll('__PI_REVIEW_PR_NUMBER__', String(t.number)).replaceAll('__PI_REVIEW_HEAD__', t.headOid)",
        ".replaceAll('__PI_REVIEW_PR_URL__', `https://github.com/${t.repository}/pull/${t.number}`).replaceAll('__PI_REVIEW_BODY_SHA256__', sha256(body)).replaceAll('__PI_REVIEW_MARKER__', marker);",
        "CL-D33 drafts exactly two artifacts",
        "s.publication = { comment: path.join(pub, 'review-comment.md'), script: path.join(pub, 'publish-review.sh') };",
        "const pub = fs.mkdtempSync(path.join(this.dir, 'publish.'));",
        "The CL-D33 report: both paths, the body digest, the one command, and the head binding; the operator runs it.",
        "`publication_grant: ${s.grant || 'review-only not-applicable'}`"
      ]
    },
    {
      "id": "CL-D33-boundary-template",
      "marker": "CL-D33",
      "title": "The template says it is copied byte-for-byte with each placeholder replaced once",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "template byte-for-byte and replace each exact ASCII placeholder below once in"
      ]
    },
    {
      "id": "CL-D33-boundary-record",
      "marker": "CL-D33",
      "title": "The owner executing the printed command is the publication grant",
      "files": [
        "contract/CL-D33.md"
      ],
      "requires": [
        "review-only drafts the artifacts but never executes or posts; the owner executing the printed Bash command supplies the publication grant"
      ]
    },
    {
      "id": "CL-D33-artifacts",
      "marker": "CL-D33",
      "title": "Publication artifacts and body provenance",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "review-comment.md",
        "publish-review.sh",
        "review-comment bytes are never interpolated into shell source",
        "complete final `review-comment.md` bytes"
      ]
    },
    {
      "id": "CL-D33-marker",
      "marker": "CL-D33",
      "title": "Non-circular deterministic publication marker",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "pi-tidd-agents:review-publication:v1",
        "visibleSha256=<sha256-of-canonical-visible-comment-bytes>",
        "non-circular"
      ]
    },
    {
      "id": "CL-D33-guards",
      "marker": "CL-D33",
      "title": "Fail-closed publication guards",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "`gh` authentication",
        "exact repository/PR/OPEN lifecycle/full URL",
        "unchanged public head",
        "complete paginated comment evidence",
        "absence of the exact marker",
        "publication artifacts must remain outside every repository",
        "Inherited Git-discovery variables are untrusted",
        "private review-comment snapshot",
        "already active or was already attempted",
        "Re-bracket the mutable target",
        "Missing, malformed, incomplete, stale, duplicate, or conflicting evidence fails closed"
      ]
    },
    {
      "id": "CL-D33-post",
      "marker": "CL-D33",
      "title": "One-shot owner publication",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "gh pr comment <full-pr-url> --body-file <review-comment.md>",
        "sole permitted operation",
        "never retried automatically",
        "stable comment URL",
        "non-overwriting receipt outside the repository",
        "Print the validated provider result before local receipt creation"
      ]
    },
    {
      "id": "CL-D33-portability",
      "marker": "CL-D33",
      "title": "Portable generated publisher",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "bash",
        "TMPDIR:-/tmp",
        "mktemp",
        "sha256sum",
        "shasum -a 256",
        "iconv -f UTF-8 -t UTF-8",
        "must end with one LF"
      ]
    },
    {
      "id": "CL-D33-status",
      "marker": "CL-D33",
      "title": "The report names the exact command, the repository/PR/head binding, and the operator",
      "files": [
        "skills/closed-loop-pr/driver/run.js"
      ],
      "requires": [
        "To publish, the operator runs: bash",
        "repository ${t.repository}, pull request #${t.number}, head ${t.headOid}",
        "The comment is bound to that head; a changed head requires fresh review. It is posted under the operator's own GitHub account."
      ]
    },
    {
      "id": "CL-D33-packaging",
      "marker": "CL-D33",
      "title": "Template remains package-owned",
      "files": [
        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "Issue #41 template",
        "gh api --paginate",
        "review-comment.md digest"
      ]
    }
  ]
}
