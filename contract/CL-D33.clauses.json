{
  "clauses": [
    {
      "id": "CL-D33-boundary",
      "marker": "CL-D33",
      "title": "Review-only drafts guarded owner publication artifacts",
      "files": [
        "skills/closed-loop-pr/references/review-only.md"
      ],
      "requires": [
        "read sibling `publish-review.sh` completely",
        "copies it byte-for-byte",
        "replaces all six exact ASCII placeholders once",
        "exactly two UTF-8/LF artifacts",
        "fresh external `mktemp` directory",
        "The owner executing that command is the publication grant",
        "Review-only never executes the script",
        "publication_grant: review-only not-applicable"
      ],
      "section": "### Guarded owner publication artifacts (CL-D33, Issue #41)"
    },
    {
      "id": "CL-D33-artifacts",
      "marker": "CL-D33",
      "title": "Publication artifacts and body provenance",
