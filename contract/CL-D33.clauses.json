        "skills/closed-loop-pr/references/publish-review.sh"
      ],
      "requires": [
        "bash",
        "TMPDIR:-/tmp",
        "mktemp",
        "sha256sum",
        "shasum -a 256",
        "iconv -f UTF-8 -t UTF-8",
        "must end with one LF"
      ]
    },
    {
      "id": "CL-D33-status",
      "marker": "CL-D33",
      "title": "Operator status attribution",
      "files": [
